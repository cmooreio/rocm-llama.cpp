# ROCm llama.cpp Docker Image Version Configuration
# This is the single source of truth for version information
# Used by: Dockerfile, Makefile, build.sh, and test scripts

# ROCm base image version and digest
ROCM_VERSION=7.2-complete
ROCM_DIGEST=sha256:86e11093b4a7ec2a79b1b6701d10e840a6994f21c7e05929b51eb9be361c683a

# llama.cpp version/tag from ggml-org/llama.cpp repository
# Update this to pin to a specific release tag
LLAMACPP_VERSION=b10664

# AMD GPU microarchitectures to compile for
# Broader compatibility = longer build time
# LLAMACPP_ROCM_ARCH=gfx803,gfx900,gfx906,gfx908,gfx90a,gfx942,gfx1010,gfx1030,gfx1032,gfx1100,gfx1101,gfx1102
LLAMACPP_ROCM_ARCH=gfx1151

# Auto-populated during build (do not modify manually)
BUILD_DATE=
VCS_REF=
